###############################
# 🔐 API KEYS
###############################

# Gemini recipe generation API key
VITE_GEMINI_API_KEY=your_api_key_here

# Optional: weather API key (not used currently)
VITE_WEATHER_API_KEY=

# Optional: analytics tools
VITE_ANALYTICS_API_KEY=

# Optional: backend API key
VITE_HARU_BACKEND_API_KEY=


###############################
# 🌐 API ENDPOINTS
###############################

# Optional: custom weather API URL
VITE_WEATHER_API_URL=

# Optional: upcoming backend server URL
VITE_HARU_BACKEND_URL=


###############################
# ⚙️ APP SETTINGS
###############################

# App environment (development | production)
VITE_APP_ENV=development

# Default city for weather (if UI wants to support multi-city)
VITE_DEFAULT_CITY=Sapporo

# Recipe text max length (optional)
VITE_RECIPE_MAX_LENGTH=
